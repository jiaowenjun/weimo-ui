{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "card-composer",
  "type": "registry:ui",
  "title": "Card Composer",
  "description": "A new-note composer shell that reuses Card editing, focus, and height-transition behavior.",
  "categories": [
    "surface",
    "editor"
  ],
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
    "@weimo/style",
    "@weimo/card",
    "@weimo/ghost-icon-button"
  ],
  "files": [
    {
      "path": "packages/weimo-ui-card/src/components/card-composer.tsx",
      "type": "registry:ui",
      "target": "@ui/card-composer.tsx"
    },
    {
      "path": "packages/weimo-ui-card/src/components/composer/card-composer.tsx",
      "type": "registry:ui",
      "target": "@ui/composer/card-composer.tsx"
    },
    {
      "path": "packages/weimo-ui-card/src/components/composer/composer-shell.tsx",
      "type": "registry:ui",
      "target": "@ui/composer/composer-shell.tsx"
    },
    {
      "path": "packages/weimo-ui-card/src/components/composer/card-composer.css",
      "type": "registry:ui",
      "target": "@ui/composer/card-composer.css"
    }
  ]
}
