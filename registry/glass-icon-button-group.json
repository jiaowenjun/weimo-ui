{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "glass-icon-button-group",
  "type": "registry:ui",
  "title": "Glass Icon Button Group",
  "description": "A round-pill glass surface hosting borderless icon buttons that inherit the glass hover overlay and press feedback.",
  "categories": [
    "action"
  ],
  "dependencies": [
    "class-variance-authority"
  ],
