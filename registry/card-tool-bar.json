{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "type": "registry:ui",
  "dependencies": [
    "lucide-react"
  ],
  "name": "card-tool-bar",
  "title": "Card Tool Bar",
  "description": "A card editing bottom toolbar with save action and custom toolbar slot.",
  "categories": [
    "action",
    "toolbar"
  ],
  "registryDependencies": [
    "@weimo/style",
    "@weimo/utils",
    "@weimo/bottom-bar",
    "@weimo/glass-icon-button"
  ],
  "files": [
    {
      "path": "src/components/card-tool-bar.tsx",
      "type": "registry:ui",
      "target": "@ui/card-tool-bar.tsx"
    },
    {
      "path": "src/components/card-tool-bar.css",
      "type": "registry:ui",
      "target": "@ui/card-tool-bar.css"
    },
    {
      "path": "src/components/glass-icon-button.tsx",
      "type": "registry:ui",
      "target": "@ui/glass-icon-button.tsx"
    },
    {
      "path": "src/components/icon-button-model.ts",
      "type": "registry:ui",
      "target": "@ui/icon-button-model.ts"
    },
    {
      "path": "src/components/icon-button.css",
      "type": "registry:ui",
      "target": "@ui/icon-button.css"
    },
    {
      "path": "src/components/glass-surface.tsx",
      "type": "registry:ui",
      "target": "@ui/glass-surface.tsx"
    },
    {
      "path": "src/components/glass-surface-model.ts",
      "type": "registry:ui",
      "target": "@ui/glass-surface-model.ts"
    },
    {
      "path": "src/components/glass-surface.css",
      "type": "registry:ui",
      "target": "@ui/glass-surface.css"
    }
  ]
}
