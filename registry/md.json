{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "type": "registry:ui",
  "dependencies": [
    "react-markdown",
    "remark-gfm",
    "remark-math",
    "remark-breaks",
    "rehype-katex",
    "katex"
  ],
  "name": "md",
  "title": "Md",
  "description": "A Markdown style and token inspection wrapper backed by MdRender.",
  "categories": [
    "style",
    "markdown"
  ],
  "registryDependencies": [
    "@weimo/style",
    "@weimo/utils",
    "@weimo/md-render"
  ],
  "files": [
    {
      "path": "src/components/md.tsx",
      "type": "registry:ui",
      "target": "@ui/md.tsx"
    },
    {
      "path": "src/components/md.css",
      "type": "registry:ui",
      "target": "@ui/md.css"
    }
  ]
}
