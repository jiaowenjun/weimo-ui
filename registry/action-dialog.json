{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "type": "registry:ui",
  "dependencies": [
    "@base-ui/react",
    "lucide-react"
  ],
  "name": "action-dialog",
  "title": "Action Dialog",
  "description": "A Base UI dialog composed with a Weimo floating top toolbar, optional right actions, and a bottom action bar.",
  "categories": [
    "overlay",
    "action"
  ],
  "registryDependencies": [
    "@weimo/style",
    "@weimo/utils",
    "@weimo/float-bar",
    "@weimo/bottom-bar",
    "@weimo/frosted-icon-button"
  ],
  "files": [
    {
      "path": "packages/weimo-ui-core/src/components/composites/action-dialog/action-dialog.tsx",
      "type": "registry:ui",
      "target": "@ui/action-dialog.tsx"
    },
    {
      "path": "packages/weimo-ui-core/src/components/composites/action-dialog/action-dialog.css",
      "type": "registry:ui",
      "target": "@ui/action-dialog.css"
    },
    {
      "path": "packages/weimo-ui-core/src/components/primitives/dialog.tsx",
      "type": "registry:ui",
      "target": "@ui/coss/dialog.tsx"
    },
    {
      "path": "packages/weimo-ui-core/src/components/primitives/dialog.css",
