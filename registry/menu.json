{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "menu",
  "type": "registry:ui",
  "title": "Menu",
  "description": "A Coss/Base UI action menu with Weimo frosted popup material and skyline-style scale animation.",
  "categories": [
    "action",
    "overlay"
  ],
  "dependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "lucide-react"
  ],
  "registryDependencies": [
    "@weimo/style",
    "@weimo/utils"
  ],
  "files": [
    {
      "path": "src/components/menu.tsx",
      "type": "registry:ui",
      "target": "@ui/menu.tsx"
    },
    {
      "path": "src/components/menu/menu-variants.ts",
      "type": "registry:ui",
      "target": "@ui/menu/menu-variants.ts"
    },
    {
      "path": "src/components/menu.css",
      "type": "registry:ui",
      "target": "@ui/menu.css"
    },
    {
      "path": "src/components/glass-surface.tsx",
      "type": "registry:ui",
      "target": "@ui/glass-surface.tsx"
    },
    {
      "path": "src/components/glass-surface-model.ts",
      "type": "registry:ui",
      "target": "@ui/glass-surface-model.ts"
    },
    {
      "path": "src/components/glass-surface.css",
      "type": "registry:ui",
      "target": "@ui/glass-surface.css"
    }
  ]
}
