{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "top-bar",
  "type": "registry:ui",
  "title": "Top Bar",
  "description": "A fixed-position blank glass top panel that renders caller-owned children.",
  "categories": [
    "navigation"
  ],
  "registryDependencies": [
    "@weimo/style",
    "@weimo/utils"
  ],
  "files": [
    {
      "path": "src/components/top-bar.tsx",
      "type": "registry:ui",
      "target": "@ui/top-bar.tsx"
    },
    {
      "path": "src/components/top-bar.css",
      "type": "registry:ui",
      "target": "@ui/top-bar.css"
    }
  ]
}
