{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "type": "registry:ui",
  "dependencies": [
    "remark-gfm",
    "remark-math",
    "remark-parse",
    "remark-stringify",
    "unified"
  ],
  "name": "md-view",
  "title": "Md View",
  "description": "A markdown view/edit bridge that swaps MdRender and MdEditor while preserving measured height.",
  "categories": [
    "markdown",
    "display",
    "input"
  ],
  "registryDependencies": [
    "@weimo/style",
    "@weimo/utils",
    "@weimo/md-editor",
    "@weimo/md-render"
  ],
  "files": [
    {
      "path": "src/components/md-view.tsx",
      "type": "registry:ui",
      "target": "@ui/md-view.tsx"
    },
    {
      "path": "src/components/md-view.css",
      "type": "registry:ui",
      "target": "@ui/md-view.css"
    }
  ]
}
