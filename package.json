{
  "name": "weimo-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "license": "MIT",
  "description": "weimo-ui 组件家族 monorepo:core/template/editor/stats/tagtree/image/ocr/agent 八包",
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "dev": "pnpm -r --filter './packages/*' build && pnpm -r --parallel --filter './packages/*/site' run dev",
    "build": "pnpm -r build",
    "verify": "pnpm -r build && pnpm -r verify",
    "site:build": "pnpm -r build && node scripts/assemble-pages.mjs",
    "site:preview": "pnpm --dir packages/weimo-ui-core/site exec vite preview --config ../../../scripts/site-preview.config.mjs",
    "dev:core": "pnpm --dir packages/weimo-ui-core site:dev",
    "dev:template": "pnpm --dir packages/weimo-ui-template site:dev",
    "dev:editor": "pnpm --dir packages/weimo-ui-editor site:dev",
    "dev:stats": "pnpm --dir packages/weimo-ui-stats site:dev",
    "dev:tagtree": "pnpm --dir packages/weimo-ui-tagtree site:dev",
    "dev:image": "pnpm --dir packages/weimo-ui-image site:dev",
    "dev:ocr": "pnpm --dir packages/weimo-ui-ocr site:dev",
    "dev:agent": "pnpm --dir packages/weimo-ui-agent site:dev"
  }
}
