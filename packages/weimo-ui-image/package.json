{
  "name": "weimo-ui-image",
  "private": false,
  "version": "0.1.2",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaowenjun/weimo-ui-image.git"
  },
  "packageManager": "pnpm@12.4.2",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/canvas-transparency": {
      "types": "./dist/components/canvas-transparency/canvas-transparency.d.ts",
      "import": "./dist/components/canvas-transparency/canvas-transparency.js"
    },
    "./components/canvas-transparency-cache": {
      "types": "./dist/components/canvas-transparency/canvas-transparency-cache.d.ts",
      "import": "./dist/components/canvas-transparency/canvas-transparency-cache.js"
    },
    "./components/image-uploader": {
      "types": "./dist/components/image-uploader/image-uploader.d.ts",
      "import": "./dist/components/image-uploader/image-uploader.js"
    },
    "./components/image-view": {
      "types": "./dist/components/image-view/image-view.d.ts",
      "import": "./dist/components/image-view/image-view.js"
    },
    "./styles/image-uploader.css": {
      "types": "./dist/components/image-uploader/image-uploader.d.css.ts",
      "default": "./dist/components/image-uploader/image-uploader.css"
    },
    "./styles/image-view.css": {
      "types": "./dist/components/image-view/image-view.d.css.ts",
      "default": "./dist/components/image-view/image-view.css"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "site:dev": "pnpm build && pnpm --dir site dev",
    "site:build": "pnpm build && pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:typecheck": "pnpm typecheck",
    "test": "vitest run",
    "check:package": "pnpm build && publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "test:site-template": "node scripts/site-template-contract.mjs",
    "test:css-tokens": "node scripts/css-token-contract.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm test:site-template && pnpm check:package && pnpm test:css-tokens && pnpm --dir site build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.54.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "weimo-ui-core": "~0.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^6.1.4",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "weimo-ui-core": "workspace:*"
  }
}
