{
  "name": "weimo-ui-ocr",
  "private": false,
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaowenjun/weimo-ui-ocr.git"
  },
  "packageManager": "pnpm@12.4.2",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/ocr-card": {
      "types": "./dist/components/ocr-card/ocr-card.d.ts",
      "import": "./dist/components/ocr-card/ocr-card.js"
    },
    "./components/ocr-composer": {
      "types": "./dist/components/ocr-composer/ocr-composer.d.ts",
      "import": "./dist/components/ocr-composer/ocr-composer.js"
    },
    "./components/ocr-detail": {
      "types": "./dist/components/ocr-detail/ocr-detail.d.ts",
      "import": "./dist/components/ocr-detail/ocr-detail.js"
    },
    "./components/tag-bar": {
      "types": "./dist/components/tags/tag-bar.d.ts",
      "import": "./dist/components/tags/tag-bar.js"
    },
    "./components/tag-picker": {
      "types": "./dist/components/tags/tag-picker/index.d.ts",
      "import": "./dist/components/tags/tag-picker/index.js"
    },
    "./components/editable-capsule": {
      "types": "./dist/components/tags/editable-capsule.d.ts",
      "import": "./dist/components/tags/editable-capsule.js"
    },
    "./lib/markdown-bridge": {
      "types": "./dist/lib/markdown-bridge.d.ts",
      "import": "./dist/lib/markdown-bridge.js"
    },
    "./styles/ocr-card.css": {
      "types": "./dist/components/ocr-card/ocr-card.d.css.ts",
      "default": "./dist/components/ocr-card/ocr-card.css"
    },
    "./styles/ocr-composer.css": {
      "types": "./dist/components/ocr-composer/ocr-composer.d.css.ts",
      "default": "./dist/components/ocr-composer/ocr-composer.css"
    },
    "./styles/ocr-detail.css": {
      "types": "./dist/components/ocr-detail/ocr-detail.d.css.ts",
      "default": "./dist/components/ocr-detail/ocr-detail.css"
    },
    "./styles/tag-bar.css": {
      "types": "./dist/components/tags/tag-bar.d.css.ts",
      "default": "./dist/components/tags/tag-bar.css"
    },
    "./styles/tag-picker.css": {
      "types": "./dist/components/tags/tag-picker/tag-picker.d.css.ts",
      "default": "./dist/components/tags/tag-picker/tag-picker.css"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "site:dev": "pnpm build && pnpm --dir site dev",
    "site:build": "pnpm build && pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:typecheck": "pnpm typecheck",
    "test": "vitest run",
    "check:package": "pnpm build && publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "test:site-template": "node scripts/site-template-contract.mjs",
    "test:css-tokens": "node scripts/css-token-contract.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm test:site-template && pnpm check:package && pnpm test:css-tokens && pnpm --dir site build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.54.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "weimo-ui-core": "~0.4.0",
    "weimo-ui-editor": "~0.4.2",
    "weimo-ui-image": "~0.1.1",
    "weimo-ui-tagtree": "~0.5.0",
    "weimo-wdf": "^0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@base-ui/react": "1.9.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^6.1.4",
    "typescript": "~7.0.2",
    "vitest": "^5.1.0",
    "weimo-ui-core": "workspace:*",
    "weimo-ui-editor": "workspace:*",
    "weimo-ui-image": "workspace:*",
    "weimo-ui-tagtree": "workspace:*",
    "weimo-wdf": "^0.1.0"
  }
}
