{
  "name": "weimo-ui-agent",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiaowenjun/weimo-ui.git"
  },
  "packageManager": "pnpm@12.4.2",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./components/conversation-composer-zcode": {
      "types": "./dist/components/conversation-composer-zcode/index.d.ts",
      "import": "./dist/components/conversation-composer-zcode/index.js"
    },
    "./styles/conversation-composer-zcode.css": {
      "types": "./dist/components/conversation-composer-zcode/conversation-composer-zcode.d.css.ts",
      "default": "./dist/components/conversation-composer-zcode/conversation-composer-zcode.css"
    },
    "./components/conversation-composer-dsh": {
      "types": "./dist/components/conversation-composer-dsh/index.d.ts",
      "import": "./dist/components/conversation-composer-dsh/index.js"
    },
    "./styles/conversation-composer-dsh.css": {
      "types": "./dist/components/conversation-composer-dsh/conversation-composer-dsh.d.css.ts",
      "default": "./dist/components/conversation-composer-dsh/conversation-composer-dsh.css"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "pnpm clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "site:dev": "pnpm build && pnpm --dir site dev",
    "site:build": "pnpm build && pnpm --dir site build",
    "site:preview": "pnpm --dir site preview",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test:typecheck": "pnpm typecheck",
    "test": "vitest run",
    "check:package": "pnpm build && publint && attw --pack . --profile esm-only --ignore-rules internal-resolution-error",
    "test:site-template": "node scripts/site-template-contract.mjs",
    "test:css-tokens": "node scripts/css-token-contract.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm test:site-template && pnpm check:package && pnpm test:css-tokens && pnpm --dir site build",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.69.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "weimo-ui-core": "~0.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "publint": "^0.3.25",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rimraf": "^6.1.3",
    "typescript": "~7.0.2",
    "vitest": "^5.0.3",
    "weimo-ui-core": "workspace:*"
  }
}
